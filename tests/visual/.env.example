# R2 credentials for visual testing
# Copy this file to .env and fill in the values
# (same credentials as devtools/visual-testing/.env)

# Shared credentials
SD_TESTING_R2_ACCOUNT_ID=
SD_TESTING_R2_ACCESS_KEY_ID=
SD_TESTING_R2_SECRET_ACCESS_KEY=

# Baselines bucket (screenshot snapshots)
SD_TESTING_R2_BASELINES_BUCKET_NAME=

# Corpus bucket (test documents)
SD_TESTING_R2_BUCKET_NAME=
