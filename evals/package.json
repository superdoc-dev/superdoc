{
  "name": "@superdoc-testing/evals",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "extract-tools": "node lib/extract.mjs",
    "eval": "npx promptfoo eval --env-file .env",
    "eval:all": "npx promptfoo eval --env-file .env && npx promptfoo eval --env-file .env -c promptfooconfig.execution.yaml",
    "eval:exec": "npx promptfoo eval --env-file .env -c promptfooconfig.execution.yaml",
    "eval:gdpval": "npx promptfoo eval --env-file .env -c promptfooconfig.gdpval.yaml",
    "eval:openai": "npx promptfoo eval --env-file .env --filter-providers 'GPT-*'",
    "eval:repeat": "npx promptfoo eval --env-file .env --repeat 3 --no-cache",
    "eval:view": "npx promptfoo view",
    "eval:export": "npx promptfoo eval --env-file .env -o results/latest.json",
    "baseline:save": "node lib/save-baseline.mjs",
    "baseline:compare": "node lib/compare-baselines.mjs"
  },
  "devDependencies": {
    "promptfoo": "^0.121.1",
    "@superdoc-dev/sdk": "1.0.0-alpha.38",
    "openai": "^6.25.0"
  }
}
