# Optional provider credentials for future real-model runs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Anthropic Agent SDK runner (optional overrides)
CLAUDE_AGENT_HOME=.tmp/claude-agent-home
CLAUDE_CODE_PATH=

# Optional Vercel AI SDK direct/local provider mode
# one of: ollama | openai | openai-compatible
VERCEL_AI_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=

# OpenAI-compatible backends (e.g. LM Studio server mode)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_PROVIDER_NAME=openai-compatible

# Optional local overrides
LLM_TOOLS_EVAL_MODEL=gpt-4o-mini
PROMPTFOO_CACHE_PATH=.promptfoo-cache
VERCEL_SMOKE_TIMEOUT_MS=40000
VERCEL_SMOKE_MAX_TOOL_CALLS=5
