{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Test files are excluded from this build program and run under bun,
    // which injects describe/it at runtime; declaring vitest/globals here
    // breaks `tsc -b` consumers (v2 bundled-runtime build) in installs that
    // do not carry the public workspace's devDependencies.
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
